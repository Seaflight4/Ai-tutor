# Server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# skainet (OpenAI-compatible) gateway
SKAINET_BASE_URL=https://chat.model.tngtech.com/v1
SKAINET_API_KEY=tngai_replace_me

# Model IDs served by skainet
MODEL_OCR=tngtech/olmocr-7B-faithful
MODEL_CHAT=zai-org/GLM-5.2
MODEL_CHAT_FAST=deepseek-ai/DeepSeek-V4-Flash

# Dialogue loop policy
MAX_HINT_LOOPS=3

# Supabase (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=problem-images
