# Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Shared-secret API auth. When non-empty, every /api/* request must carry
# `X-API-Key: <API_SECRET>`. Leave empty to disable auth (dev/test).
# API_SECRET=

# Rate limiting (per client IP, /api/* only). 0 disables.
# RATE_LIMIT_PER_MINUTE=60

# Upload limits
# MAX_IMAGE_BYTES=10485760
# MAX_REPLY_CHARS=4000

# skainet (OpenAI-compatible) gateway
SKAINET_BASE_URL=https://chat.model.tngtech.com/v1
SKAINET_API_KEY=tngai_replace_me

# Model IDs served by skainet
MODEL_OCR=tngtech/olmocr-7B-faithful
MODEL_CHAT=zai-org/GLM-5.2

# LLM call parameters per role (optional; defaults are tuned for GLM-5.2)
# OCR_MAX_TOKENS=2000
# OCR_PARSE_TEMP=0.0
# OCR_PARSE_MAX_TOKENS=1000
# OPENING_TEMP=0.6
# OPENING_MAX_TOKENS=300
# TUTOR_TEMP=0.3
# TUTOR_MAX_TOKENS=1100
# SOLUTION_TEMP=0.3
# SOLUTION_MAX_TOKENS=1500
# PROFILE_TEMP=0.0
# PROFILE_MAX_TOKENS=200

# Source grounding (RAG over a curated physics reference corpus)
# REFERENCE_TOP_K=4
# REFERENCE_CORPUS_DIR=data/reference

# Supabase (PostgreSQL + pgvector). Leave SUPABASE_URL empty to use the
# local SQLite fallback (ai_tutor_local.db in the project root).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=problem-images
